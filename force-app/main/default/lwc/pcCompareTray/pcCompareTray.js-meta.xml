<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Product Compare Tray</masterLabel>
    <description>Bar fixed to the bottom of the page with the products selected for comparison. Place it in the theme layout so it shows on every page.</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="title" type="String" label="Title" default="Compare Products" translatable="true" />
            <property name="compareButtonText" type="String" label="Compare Button Text" default="Compare" translatable="true" />
            <property name="clearAllText" type="String" label="Clear All Text" default="Clear all" translatable="true" />
            <property name="comparePageApiName" type="String" label="Compare Page API Name" default="Compare__c" />
            <property name="categoryPrefix" type="String" label="Category Prefix (category mode)" default="Comparing:" translatable="true" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
